# Copy to .env and fill in. Never commit .env.
# Business rules (fees, thresholds) are NOT here - they are versioned config in the database
# (see `resale config show deal_rules` and PUT /config/{kind}).

APP_ENV=prod
LOG_LEVEL=INFO
LOG_FORMAT=json

# Used by docker-compose for the bundled PostgreSQL. Choose a long random value.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# When running outside docker-compose, set these directly:
# DATABASE_URL=postgresql+psycopg://resale:<password>@localhost:5432/resale
# REDIS_URL=redis://localhost:6379/0

BASE_CURRENCY=GBP
DISPLAY_TIMEZONE=Europe/London
DEFAULT_MARKETPLACE=vinted

# ---- Telegram ---------------------------------------------------------------
# Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot (yours). Everyone else is ignored.
# Find your ID by sending /start to your bot (it replies with your ID), or via @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=
# Where alerts are sent. Defaults to the first allowed user's private chat.
# TELEGRAM_ALERT_CHAT_ID=
# polling (default, no public URL needed) or webhook (needs HTTPS URL + secret).
TELEGRAM_MODE=polling
# TELEGRAM_WEBHOOK_URL=https://your.domain/telegram/webhook
# 16-256 characters of A-Z a-z 0-9 _ - (e.g. python -c "import secrets; print(secrets.token_urlsafe(32))")
# TELEGRAM_WEBHOOK_SECRET=

# ---- AI (optional) ----------------------------------------------------------
# Used for identification when rules are unsure, mislabel detection and the photo
# checklist. Leave the key empty to run rules-only. AI never produces prices.
AI_ENABLED=true
ANTHROPIC_API_KEY=
AI_DAILY_BUDGET_USD=1.00
AI_MONTHLY_BUDGET_USD=10.00

# ---- API ----------------------------------------------------------------------
API_RATE_LIMIT_PER_MINUTE=120
API_DOCS_ENABLED=true
